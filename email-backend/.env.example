# Copy this file to .env and fill in real values. Never commit .env.
# Wrap a value in single quotes if it contains spaces, # or quotes.

# SMTP account used to send mail
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=enquiries@yourdomain.com
SMTP_PASSWORD='change-me'
# tls (STARTTLS, usually port 587) or ssl (usually port 465).
# none disables encryption and is only for local testing.
SMTP_ENCRYPTION=tls

# Sender shown on emails. Use an address on your own domain.
MAIL_FROM_ADDRESS=enquiries@yourdomain.com
MAIL_FROM_NAME='NexGen Website'

# Comma-separated website addresses allowed to call the API, with https:// and
# no path. List both www and non-www if the site answers on both. Use "*" alone to allow any site (less safe).
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Requests allowed per visitor IP address within the window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=900
